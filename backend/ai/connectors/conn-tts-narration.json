{
  "connectorVersion": "2.0.0",
  "workflow": "tts-qwen-narrator",
  "workflowHash": "",
  "label": "TTS Narration (Qwen, voice clone)",
  "description": "Narration by cloning the narrator's locked voice reference (Base model + LoadAudio → VoiceClonePrompt → VoiceClone)",
  "type": "audio",
  "profile": {
    "audioProfile": "qwen-tts"
  },
  "metadata": {
    "author": "Animastor",
    "updated": "2026-11-12",
    "category": "audio-generation"
  },
  "compatibility": {
    "nodeClasses": {
      "79": "Qwen3TTSLoader",
      "90": "LoadAudio",
      "91": "Qwen3TTSVoiceClonePrompt",
      "108": "Qwen3TTSVoiceClone",
      "1008": "SaveAudioMP3"
    }
  },
  "inputs": {
    "narrationText": {
      "nodeId": "108",
      "field": "inputs.target_text",
      "expectedClass": "Qwen3TTSVoiceClone",
      "entityType": "narrationText",
      "label": "Narration Text",
      "required": true
    },
    "referenceAudio": {
      "nodeId": "90",
      "field": "inputs.audio",
      "expectedClass": "LoadAudio",
      "entityType": "referenceAudio",
      "label": "Reference Audio",
      "required": true
    },
    "referenceText": {
      "nodeId": "91",
      "field": "inputs.ref_text",
      "expectedClass": "Qwen3TTSVoiceClonePrompt",
      "entityType": "referenceText",
      "label": "Reference Text",
      "required": true
    }
  },
  "outputs": {
    "generatedAudio": {
      "nodeId": "1008",
      "field": "inputs.audio",
      "expectedClass": "SaveAudioMP3",
      "entityType": "generatedAudio",
      "label": "Generated Audio"
    }
  },
  "parameters": {
    "seed": {
      "nodeId": "108",
      "field": "inputs.seed",
      "expectedClass": "Qwen3TTSVoiceClone",
      "entityType": "seed",
      "label": "Seed"
    },
    "language": {
      "nodeId": "108",
      "field": "inputs.target_language",
      "expectedClass": "Qwen3TTSVoiceClone",
      "entityType": "language",
      "label": "Language",
      "default": "Russian"
    },
    "temperature": {
      "nodeId": "108",
      "field": "inputs.temperature",
      "expectedClass": "Qwen3TTSVoiceClone",
      "entityType": "temperature",
      "label": "Temperature",
      "default": 0.9
    },
    "quality": {
      "nodeId": "1008",
      "field": "inputs.quality",
      "expectedClass": "SaveAudioMP3",
      "entityType": "quality",
      "label": "Audio Quality",
      "default": "320k"
    },
    "outputFilenamePrefix": {
      "nodeId": "1008",
      "field": "inputs.filename_prefix",
      "expectedClass": "SaveAudioMP3",
      "entityType": "outputFilenamePrefix",
      "label": "Output Filename Prefix",
      "default": "audio/tts"
    }
  }
}
