  "rules": [
    {
      "id": "anna_smirnova.contradicted_in_public",
      "scope": "character",
      "character_id": "anna_smirnova",
      "description": "anna_smirnova is contradicted in public",
      "when": {
        "emotion": [
          "angry",
          "tense"
        ]
      },
      "then": {
        "action": "pauses without changing expression, then answers with one calm, exact sentence that ends the argument"
      },
      "strength": 0.7,
      "probability": 0.6,
      "cooldown_iu": 3,
      "priority": 10
    },
    {
