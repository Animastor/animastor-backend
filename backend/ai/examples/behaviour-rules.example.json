      "scope": "character",
      "character_id": "anna_smirnova",
      "description": "anna_smirnova is praised",
      "when": {
        "emotion": [
          "proud",
          "embarrassed"
        ]
      },
      "then": {
        "action": "deflects briefly with a small nod and immediately turns the conversation to work"
      },
      "strength": 0.7,
      "probability": 0.6,
      "cooldown_iu": 3,
      "priority": 10
    },
    {
