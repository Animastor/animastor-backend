{
    "name": "@animastor/orchestration",
    "version": "2.0.0",
    "description": "Animastor Orchestration 2.0.0 — generation orchestration v2 (ADR ORCHESTRATION_V2): the `gen` namespace — PG is the single source of truth (gen_commands, gen_jobs), commands / claim (FOR UPDATE SKIP LOCKED) / one-transaction acceptance / sweeper / progress over a host-supplied pg pool and host ports; no Redis, no Express, no ComfyUI. The 0.3.x legacy orchestration (src/legacy/) is removed (ADR §12 stage 4).",
    "keywords": [
        "animastor",
        "generation",
        "job-queue",
        "orchestration",
        "postgres"
    ],
    "main": "src/index.js",
    "exports": {
        ".": "./src/index.js"
    },
    "files": [
        "src/",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "test": "mocha --exit 'test/gen/*.test.js'"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
